// =============================================================================
// Environment.hlsli — 氷の周りの環境 (太陽・空・床)
//
//   Environment(ro, rd): 位置 ro から向き rd へ進む光線が見る色 (光の強さ)
//   ToDisplay(x)       : 光の強さを画面に出せる色に直す。 フレームの最後に 1 回だけ (Display.hlsl) 使う
//   FromDisplay(c)     : その逆。 デバッグの色 (表示用の色をそのまま見せたい物) を、 明るさに戻して出すときに使う
//
// 背景 (Background.hlsl) が画面に描く色と、 氷のシェーダーが屈折した光線の先に見る色は、
// どちらもこのファイルの関数で求める。 同じ式なので、 氷越しの景色と周りの景色がつながる。
// 座標は y が上、 単位はメートル。 床は y = 0 の平面。
// 太陽の向きと色はシーンの定数 (SceneConstants.hlsli) から読む。 このファイルに数字を書かない。
// =============================================================================

#ifndef ENVIRONMENT_HLSLI
#define ENVIRONMENT_HLSLI

#include "SceneConstants.hlsli"

// -----------------------------------------------------------------------------
// 太陽
// -----------------------------------------------------------------------------

// 太陽の光の色 × 強さ。 C++ の DirectionalLight (color × intensity) が毎フレーム届く
float3 SunColor()
{
    return LightColor;
}

// 太陽のある向き (地面から太陽へ向かう向き、 長さ 1)。 C++ の DirectionalLight.direction が届く
float3 SunDirection()
{
    return LightDirection;
}

// -----------------------------------------------------------------------------
// 空
// -----------------------------------------------------------------------------

// 向き rd の空の色。
//   1. 地平線 (rd.y = 0) の白っぽい青から、 天頂へ向かって濃い青へ変える。
//      rd.y × 1.6 を 0〜1 に収めて補間するので、 rd.y が 0.625 (約 39°) より上は同じ濃い青。
//   2. 太陽の円盤とその周りの明るさを足す。 s は rd と太陽の向きの cos (1 に近いほど太陽に近い)。
//      s^900 はごく狭い円盤 (反射で鋭く光る)、 s^10 は太陽の周りに広がるぼんやりした明るさ。
float3 Sky(float3 rd)
{
    float3 horizon = float3(0.62, 0.72, 0.85);
    float3 zenith  = float3(0.16, 0.34, 0.70);
    float3 col = lerp(horizon, zenith, saturate(rd.y * 1.6));

    float s = max(dot(rd, SunDirection()), 0.0);  // pow に負の数を渡さないよう 0 で止める
    return col + SunColor() * (pow(s, 900.0) * 6.0 + pow(s, 10.0) * 0.12);
}

// -----------------------------------------------------------------------------
// 床
// -----------------------------------------------------------------------------

// 床の点 p の色 (光の強さ)。
//   模様: 50 cm 角の市松模様。 氷越しにずれて見えるので、 屈折が分かりやすい。
//         floor(x × 2) + floor(z × 2) が偶数か奇数かで 2 色を選ぶ。
//         frac(n × 0.5) × 2 は、 n が偶数なら 0、 奇数なら 1 (負の数でも同じ)。
//   光  : 太陽の光 (床は上向きなので、 当たる強さは太陽の高さ SunDirection().y) と、
//         空から来る光 (どの向きからも同じだけ来ると考えた、 少し青い光) を足す。
//   sunVisibility: 太陽の光がどれだけ届くか (1 = 全部、 0 = 影)。 色付きの影のため RGB で受け取る。
//                  影を落とす物 (氷の部品) が、 自分の影の所の床を描き直すときに使う
float3 ShadeFloorLit(float3 p, float3 sunVisibility)
{
    float checker = frac((floor(p.x * 2.0) + floor(p.z * 2.0)) * 0.5) * 2.0;
    float3 albedo = lerp(float3(0.46, 0.44, 0.40), float3(0.22, 0.23, 0.26), checker);

    float3 sun = SunColor() * saturate(SunDirection().y) * sunVisibility;
    float3 ambient = float3(0.22, 0.30, 0.42);
    return albedo * (sun + ambient);
}

float3 ShadeFloor(float3 p)
{
    return ShadeFloorLit(p, float3(1.0, 1.0, 1.0));
}

// 遠くを空の色へ溶かす (霧)。 col: 距離 t の所の色、 rd: 光線の向き。 33 m で約 63% が空の色
float3 ApplyFog(float3 col, float3 rd, float t)
{
    return lerp(col, Sky(rd), 1.0 - exp(-t * 0.03));
}

// -----------------------------------------------------------------------------
// 光線の先の色
// -----------------------------------------------------------------------------

// 位置 ro から向き rd へ進む光線が見る色。
//   ・下を向いていれば床に当たる。 当たる距離 t は、 y = ro.y + rd.y × t が 0 になる所。
//     床より下から出た光線 (氷の底から出た光線など) は t が負になるので、 0 で止めて
//     「その場で床に当たった」 ことにする。
//   ・遠くの床は、 距離に応じて空の色へ溶かす (霧)。 地平線の近くで模様がちらつくのも隠せる。
//   ・上を向いていれば空。
float3 Environment(float3 ro, float3 rd)
{
    if (rd.y < 0.0) {
        float t = max(-ro.y / rd.y, 0.0);
        return ApplyFog(ShadeFloor(ro + rd * t), rd, t);
    }
    return Sky(rd);
}

// -----------------------------------------------------------------------------
// 表示
// -----------------------------------------------------------------------------

// 光の強さ (0 〜 上限なし) を、 画面に出せる色 (0 〜 1) に直す。
// 各シェーダーは呼ばない。 シーンを明るさのまま描き終えた後、 Display.hlsl が 1 回だけ呼ぶ。
//   1. トーンマップ: ACES (映画で使われる色の変換) の近似式 (Narkowicz 2016)。
//      暗い所はほぼそのまま、 明るい所はなだらかに 1 へ寄せて白飛びを和らげる。
//   2. ガンマ: バックバッファは UNORM (sRGB への自動の変換なし) なので、 ここで 1/2.2 乗する。
//      これをしないと、 中間の明るさが暗く沈んで見える。
float3 ToDisplay(float3 x)
{
    x = saturate((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14));
    return pow(x, float3(1.0 / 2.2, 1.0 / 2.2, 1.0 / 2.2));
}

// ToDisplay の逆: 表示用の色 c (0〜1) → 光の強さ。 デバッグの色 (距離の色・法線の色など) を、
// 最後の ToDisplay を通っても同じ色に見えるように出すときに使う。
//   1. ガンマを戻す: c^2.2
//   2. トーンマップを戻す: y = x(2.51x + 0.03) / (x(2.43x + 0.59) + 0.14) を x について解く。
//      (2.43y − 2.51)x² + (0.59y − 0.03)x + 0.14y = 0 の、 0 以上の解 (2 次方程式の解の公式)
float3 FromDisplay(float3 c)
{
    float3 y = pow(saturate(c), float3(2.2, 2.2, 2.2)) * 0.999;  // ガンマを戻す (1 ちょうどは解が無限大になるので少し下げる)
    float3 a = 2.43 * y - 2.51;                                   // x² の係数 (y < 1 では負)
    float3 b = 0.59 * y - 0.03;                                   // x の係数
    float3 k = 0.14 * y;                                          // 定数の項
    return (-b - sqrt(b * b - 4.0 * a * k)) / (2.0 * a);          // a < 0 なので、 この解が 0 以上
}

#endif
